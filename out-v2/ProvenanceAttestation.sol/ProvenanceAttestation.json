es32\"},{\"internalType\":\"uint8\",\"name\":\"outModelBitmap\",\"type\":\"uint8\"},{\"internalType\":\"enum ProvenanceAttestation.Decision\",\"name\":\"outDecision\",\"type\":\"uint8\"},{\"internalType\":\"bytes32\",\"name\":\"outTxHash\",\"type\":\"bytes32\"},{\"internalType\":\"address\",\"name\":\"outAttester\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"TRUST BOUNDARY \\u2014 READ BEFORE VERIFYING:  - This contract does NOT verify EIP-191 signatures and performs no    canonical-JSON reconstruction. Signature validity is established    OFF-CHAIN by the existing Phase 3 verifier (`verifyAttestation`).  - The `attester` field is the address recovered from the Phase 3    EIP-191 attestation signature. It is accepted as a declared    parameter because the transaction sender (the eventual publisher)    may use a separate transaction-signing key: msg.sender is NOT    necessarily the attestation signer.  - An independent verifier MUST check, off-chain, that the recovered    Phase 3 signer matches the recorded `attester`, that the signed    manifest digest matches `manifestDigest`, and that the attester    was an authorized (ACTIVE, or corroborated retired) registry key.  - What this contract DOES enforce: input shape (non-empty bounded    investigation id, non-zero digest, bitmap 0-3, known decision),    the BLOCK/REVIEW zero-transaction-hash rule, and no conflicting    duplicate for the same (investigationId, attester) pair.  - Model bitmap semantics (set by the attester from genuine    contribution outcomes, never from configured or skipped stages):    bit 0 = Muse Spark successfully contributed to the investigation;    bit 1 = SAM 3.1 successfully contributed to the investigation.  - Non-upgradeable by design: no owner, no pause, no access control.    Records, once written, are never modified or deleted.\",\"events\":{\"Attested(string,bytes32,address,uint8,uint8,bytes32)\":{\"details\":\"investigationId and manifestDigest are indexed for lookup;      attester is indexed so verifiers can filter by authority.\"}},\"kind\":\"dev\",\"methods\":{\"attest(string,bytes32,uint8,uint8,bytes32,address)\":{\"details\":\"Duplicate policy: an identical resubmission for the same      (investigationId, attester) succeeds silently WITHOUT emitting      a second event (idempotent publishers); any differing field      reverts with ConflictingAttestation. Different attesters hold      independent records for the same investigation (e.g.      re-attestation after key rotation).\"}},\"title\":\"Assertara Provenance Attestation Registry\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"attest(string,bytes32,uint8,uint8,bytes32,address)\":{\"notice\":\"Record a verified off-chain attestation.\"},\"getAttestation(string,address)\":{\"notice\":\"Read a stored attestation by investigation id and attester.\"}},\"notice\":\"Minimal append-only record of off-chain provenance attestations.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/ProvenanceAttestation.sol\":\"ProvenanceAttestation\"},\"evmVersion\":\"shanghai\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":false,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/ProvenanceAttestation.sol\":{\"keccak256\":\"0xcfc7ec91828fee3148115d30ccc08a4ea6d5bb6d741ad30788dbcfdaf2bde84b\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://0318ce8ffc2d284d3fe63ebc8b46edf66f89569347c3a5c6c5d558e39ab88245\",\"dweb:/ipfs/QmRRZ28fa51wTP6GU7nTAPnKR2y5UgZQ3jLqFZgXQ1R2x4\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.20+commit.a1b79de6"},"language":"Solidity","output":{"abi":[{"inputs":[],"type":"error","name":"ConflictingAttestation"},{"inputs":[],"type":"error","name":"EmptyInvestigationId"},{"inputs":[],"type":"error","name":"InvalidDecision"},{"inputs":[],"type":"error","name":"InvalidModelBitmap"},{"inputs":[],"type":"error","name":"InvestigationIdTooLong"},{"inputs":[],"type":"