{
  "manifest_version": 3,
  "name": "Assertara",
  "version": "1.0.0",
  "description": "Advisory Web3 transaction security: compares a dApp's visible promise against the transaction your wallet is asked to authorize.",
  "minimum_chrome_version": "109",
  "action": {
    "default_title": "Inspect transaction with Assertara",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:3001/*"]
}
