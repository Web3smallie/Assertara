# Visual Sentry Environment Configuration

# Server
PORT=3001
NODE_ENV=development

# Meta Model API (https://api.meta.ai/v1)
MODEL_API_KEY=your_meta_model_api_key_here
META_API_BASE_URL=https://api.meta.ai/v1

# Models
SAM_MODEL=sam-3-1
MUSE_MODEL=muse-spark-1.3

# EVM & Anvil Configuration
# Default must support read-only calls. Note: free-tier endpoints typically
# reject unfiltered eth_getLogs ranges; approval history needs an
# archive-capable RPC endpoint or API key.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
ANVIL_PORT=8545
