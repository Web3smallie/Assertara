# Assertara environment template.
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# Only MODEL_API_KEY is required for live inference; every other variable has
# the default shown here when unset (see src/config/env.js).

# Server port for `npm start` (optional, default 3001).
PORT=3001

# Node environment label (optional, default development).
NODE_ENV=development

# REQUIRED for live SAM 3.1 / Muse Spark inference. Without a real key the
# services run in labeled mock/fallback modes and live probes refuse to run.
# Paste your Meta API key here; never share or commit it.
MODEL_API_KEY=your_meta_api_key_here

# Meta Model API base URL (optional, default https://api.meta.ai/v1).
META_API_BASE_URL=https://api.meta.ai/v1

# SAM segmentation model id (optional, default sam-3.1).
# NOTE: the id uses a DOT between 3 and 1 (verified live 2026-10-28; the
# dash variant returns API 404 model_not_found).
SAM_MODEL=sam-3.1

# Muse reasoning model id (optional, default muse-spark-1.3).
MUSE_MODEL=muse-spark-1.3

# Note: simulation runs plain `forge test` with no --fork-url and no Anvil
# instance. Fork simulation is NOT implemented; no RPC endpoint or Anvil
# port is read by the application.

# Per-request timeout in ms for production SAM 3.1 calls (optional, default
# 30000). Bounds connection setup and response-body consumption; no retries.
# Must be a positive integer 1-2147483647; anything else falls back to 30000.
SAM_TIMEOUT_MS=30000

# Per-request timeout in ms for production Muse Spark calls (optional,
# default 60000). On timeout the deterministic heuristic fallback is used.
# Must be a positive integer 1-2147483647; anything else falls back to 60000.
MUSE_TIMEOUT_MS=60000

# Output-token limit for Muse Spark investigation responses (optional,
# default 24000). Must cover the model's hidden reasoning tokens PLUS
# the structured output (reasoning alone can reach ~4000 tokens); a small
# cap truncates the response to empty. Invalid values fall back to 24000.
MUSE_MAX_TOKENS=24000

# ---------------------------------------------------------------------------
# Autonomous agent execution system (policy service + controlled signer).
# All optional: without them the server still serves /api/v1/evaluate, but
# agent proposals are UNCERTAIN (no mandate) or 503 (no APPROVAL_SECRET),
# and the signer refuses to start. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Operator-owned mandate file (REQUIRED for agent execution). Independently
# authorised: the agent can never supply its own mandate. The file must
# carry a cryptographic seal (see OPERATOR_SIGNING_KEY below); unsealed
# mandates are rejected, never silently trusted.
MANDATE_FILE=./mandates/agent-mandate.json

# Trusted mandate-sealing authorities, comma-separated addresses (REQUIRED
# for agent execution). Must include the authority that sealed MANDATE_FILE.
TRUSTED_MANDATE_AUTHORITIES=0xoperator-authority-address-here

# Operator mandate-signing key (sealing ceremony ONLY: `npm run
# seal-mandate -- <file>`). NEVER place on the policy server, signer,
# agent, or browser. The corresponding address goes in the authority lists.
OPERATOR_SIGNING_KEY=0x-your-operator-sealing-key-here

# Approval-issuing/HMAC secret, >=16 chars (REQUIRED for agent endpoints and
# the signer). Shared by policy service and signer only; never given to the
# agent, models, or browser code.
APPROVAL_SECRET=replace-with-32-plus-random-hex-chars

# Operator countersigning secret (REQUIRED to release REVIEW decisions).
OPERATOR_SECRET=replace-with-32-plus-random-hex-chars

# Approval token lifetime in ms (optional, default 300000).
APPROVAL_TTL_MS=300000

# Agent request lifetime in ms (optional, default 900000).
REQUEST_TTL_MS=900000

# Append-only JSONL audit/spending logs (optional, defaults under data/).
AGENT_LEDGER_FILE=data/agent-ledger.jsonl
SPENDING_LEDGER_FILE=data/agent-spending.jsonl

# Durable request snapshot, written atomically (optional, default
# data/agent-requests.json). Request state, decisions, approvals, and
# execution records survive restarts; a corrupt snapshot fails closed.
AGENT_SNAPSHOT_FILE=data/agent-requests.json

# Signer process only (read by src/signer/server.js, NEVER by the policy
# service or agent code). Local development key for Anvil; never a real
# wallet. The key must match the mandate signerAddress.
SIGNER_PRIVATE_KEY=0x-your-32-byte-dev-key-here
SIGNER_PORT=3002
SIGNER_CONSUMED_FILE=data/signer-consumed.jsonl
# Replay integrity anchor (optional; defaults next to the consumed log).
# Together with the HMAC-chained log it detects deletion, truncation,
# and rollback of approval-consumption records.
SIGNER_ANCHOR_FILE=data/signer-consumed-replay-anchor.json
# Signer continuity state (optional; defaults next to the consumed log).
# Records the last-boot mandate version so restarts reject rollbacks.
SIGNER_STATE_FILE=data/signer-consumed-state.json
# Trusted mandate-sealing authorities for the signer (REQUIRED). The
# signer refuses to start without this list or with an unsealed mandate.
SIGNER_TRUSTED_MANDATE_AUTHORITIES=0xoperator-authority-address-here
POLICY_CALLBACK_URL=http://127.0.0.1:3001/api/v1/internal/signer-callback

# ---------------------------------------------------------------------------
# Evidence Assembly / Muse Spark investigation (Phase B). All optional.
# When unset, the affected evidence is explicitly recorded as unavailable in
# the bundle and prompt instead of being fabricated.
# ---------------------------------------------------------------------------

# Chain RPC endpoint for investigation-time state reads (balance, nonce,
# code presence). If unset, chain state is recorded as `unavailable`.
EVIDENCE_CHAIN_RPC_URL=http://127.0.0.1:8545
# Chain-state RPC timeout in ms (optional, default 8000).
EVIDENCE_CHAIN_TIMEOUT_MS=8000
# Screenshot freshness window in ms (optional, default 300000 = 5 min).
SCREENSHOT_MAX_AGE_MS=300000
# Operator counterparty labels file (optional, default data/labels.json).
# JSON object mapping address -> display name. Hints only; never affects
# mandate, policy, or comparison outcomes.
COUNTERPARTY_LABELS_FILE=data/labels.json
# Investigation record store (optional, default data/investigations.jsonl).
# Append-only JSONL of completed investigations for qualitative review.
# Screenshots and secrets are redacted before anything is written.
INVESTIGATIONS_FILE=data/investigations.jsonl
# Selector signature directory (optional, default enabled). Unknown
# selectors are looked up at 4byte.directory for an earliest-submitted
# text hint (collisions counted); HINT only, never behavior proof.
# Set to 0/false to disable.
SELECTOR_LOOKUP_ENABLED=1
# Selector lookup timeout in ms (optional, default 2500).
SELECTOR_LOOKUP_TIMEOUT_MS=2500
# Source verification via Sourcify v2 (optional, default enabled). Only
# full matches count as source-verified; 404 means unverified. Set to
# 0/false to disable.
SOURCIFY_LOOKUP_ENABLED=1
# Sourcify lookup timeout in ms (optional, default 2500).
SOURCIFY_LOOKUP_TIMEOUT_MS=2500
# Operator bytecode references (optional, no default). JSON object
# mapping chain id -> address -> trusted runtime codeHash. Enables the
# bytecode-matched identity tier; absence skips it honestly.
CONTRACT_BYTECODE_REFS_FILE=data/bytecode-refs.json
# Transaction history window (optional). Chain event logs cover the
# last HISTORY_BLOCK_WINDOW blocks (default 2000, clamped 100-50000);
# at most HISTORY_MAX_ENTRIES entries reach the investigator
# (default 8, clamped 1-32). Set HISTORY_ENABLED to 0/false to
# disable history assembly.
HISTORY_ENABLED=1
HISTORY_BLOCK_WINDOW=2000
HISTORY_MAX_ENTRIES=8

# ---------------------------------------------------------------------------
# Phase 3 provenance attestation (offline operator ceremony ONLY).
# These keys authorize NOTHING on-chain: they sign provenance manifests,
# never transactions. Ceremony tools: src/attestation/keygen.js,
# src/attestation/registry.js, src/attestation/attest.js.
# NEVER place these on the policy server, signer, agent, or browser.
# NEVER reuse user wallet, transaction-signing, operator, deployment,
# or registry-root keys here. See docs/attestation.md.
#
# WARNING: NEVER put real Phase 3 values in the repository .env file.
# src/config/env.js loads .env into every server/agent process, which
# would expose ceremony keys outside the offline ceremony. Load keys
# interactively at ceremony time (read -s, then unset) or from a
# restricted file OUTSIDE the repo, exactly as docs/attestation.md shows.
# NEVER type a real key into a shell command or export statement.
# ---------------------------------------------------------------------------

# Dedicated Assertara attestation key (ceremony time ONLY). Loaded from the
# environment by attest.js --confirm and never stored, logged, or echoed.
# Placeholder shape only — a real key must NEVER be written here.
ATTESTATION_SIGNING_KEY=0x-your-32-byte-attestation-key-here

# Trusted attestation authorities, comma-separated addresses (REQUIRED for
# the ceremony and for judge-side verification). Must include the signing
# key's address; keys identify authorities but never authorize transactions.
TRUSTED_ATTESTATION_AUTHORITIES=0xattestation-authority-address-here

# Trusted registry root address (REQUIRED). Must match the root fingerprint
# published through TWO independent out-of-band channels — never trust the
# registry file's own claim about its root.
TRUSTED_REGISTRY_ROOT=0xregistry-root-address-here

# Deny-listed addresses, comma-separated (optional but recommended).
# Refuse to sign if the ceremony key matches: transaction-signer,
# operator, deployment, and any retired/compromised addresses.
ATTESTATION_DENY_ADDRESSES=0xsigner-address-here,0xoperator-address-here

# Offline registry-root key (registry signing ONLY: `node
# src/attestation/registry.js sign`). NEVER on any server. The root signs
# registry updates; it must never double as a day-to-day attestation key.
# Placeholder shape only — a real key must NEVER be written here.
REGISTRY_ROOT_KEY=0x-your-32-byte-registry-root-key-here
